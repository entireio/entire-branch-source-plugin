<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <f:entry title="Entire auth URL" field="coreUrl"><f:textbox default="https://auth.entire.io"/></f:entry>
  <f:entry title="Plugin slug" field="pluginSlug"><f:textbox/></f:entry>
  <f:entry title="Installation ID" field="installationId"><f:textbox/></f:entry>
  <f:entry title="Private key (Ed25519 PKCS#8 PEM)" field="privateKey"><f:secretTextarea/></f:entry>
  <st:include page="id-and-description" class="${descriptor.clazz}"/>
</j:jelly>
